{
  "name": "enviroaqua-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:products && npm run validate:redirects && npm run test:analytics && npm run test:attribution",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:shopify": "tsx scripts/test-shopify-fetch.ts",
    "test:analytics": "tsx --test tests/analytics.test.ts",
    "test:attribution": "tsx --test tests/attribution.test.ts",
    "audit:watermark": "tsx scripts/audit-watermark-status.ts",
    "validate:products": "tsx scripts/validate-products.ts",
    "validate:redirects": "tsx scripts/validate-migration-redirects.ts",
    "bootstrap:products": "tsx scripts/bootstrap-products-json.ts"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@shopify/storefront-api-client": "^1.0.4",
    "lucide-react": "^0.469.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^4.0.1",
    "puppeteer-core": "^24.11.0",
    "@sparticuz/chromium": "^138.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
